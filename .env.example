# BearTracks Sniper settings.
# The first run copies this file to .env and asks for anything required that's empty.
# .env holds your password in plain text, so never send it to anyone.

# --- Your login ---
# CCID is the part of your email before @ualberta.ca
UOFA_USERNAME=
UOFA_PASSWORD=

# --- What to watch ---
# The course as Schedule Builder shows it, e.g. INT D 249
COURSE_IDENTIFIER=
# Leave empty to pick the term from a list the next time it starts
TERM_ID=

# --- Discord alerts (optional, leave empty to turn off) ---
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Your user ID, so alerts ping you. Settings > Advanced > Developer Mode, then right-click your name > Copy User ID
DISCORD_USER_ID=

# --- Tuning ---
# Seconds between seat checks
CHECK_INTERVAL_SECONDS=30
# Send an alert after this many failed automatic re-logins in a row
LOGIN_FAILURE_NOTIFY_THRESHOLD=3
